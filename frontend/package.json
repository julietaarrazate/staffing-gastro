{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/patch-opennext.mjs && node scripts/copy-maplibre-worker.mjs",
    "cf:build": "opennextjs-cloudflare build && node scripts/cf-static-assets.mjs",
    "cf:preview": "npm run cf:build && wrangler dev --port 8787",
    "cf:deploy": "npm run cf:build && wrangler deploy"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.8.0",
    "@vis.gl/react-maplibre": "^8.1.3",
    "lucide-react": "^1.22.0",
    "maplibre-gl": "^6.13.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.150.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "next": {
      "postcss": "^8.5.18"
    },
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.16"
    },
    "source-map-js": "^1.2.2",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
