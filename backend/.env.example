# --- Aplicación ---
APP_NAME=Staffya
ENVIRONMENT=development
DEBUG=true

# --- Base de datos (PostgreSQL) ---
# Formato async: postgresql+asyncpg://usuario:password@host:puerto/db
DATABASE_URL=postgresql+asyncpg://staffya:staffya@localhost:5432/staffya

# --- Seguridad / JWT ---
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=cambiar-esto-por-una-clave-secreta-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Administración ---
# Emails que se promueven a rol admin al iniciar la app (separados por coma).
# Permite dar de alta al primer administrador sin endpoint de auto-registro.
# El usuario debe registrarse primero (como worker/employer); al reiniciar la
# app con su email acá, se lo promueve a admin.
ADMIN_EMAILS=
