# --- Aplicación ---
APP_NAME=Staffya
ENVIRONMENT=development
DEBUG=true

# --- Base de datos (PostgreSQL) ---
# Formato async: postgresql+asyncpg://usuario:password@host:puerto/db
DATABASE_URL=postgresql+asyncpg://staffya:staffya@localhost:5432/staffya

# --- Seguridad / JWT ---
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=cambiar-esto-por-una-clave-secreta-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Administración ---
# Emails que se promueven a rol admin al iniciar la app (separados por coma).
# Permite dar de alta al primer administrador sin endpoint de auto-registro.
# El usuario debe registrarse primero (como worker/employer); al reiniciar la
# app con su email acá, se lo promueve a admin.
ADMIN_EMAILS=

# --- Acceso invitado (beta, "Explorar sin cuenta") ---
# PIN para entrar sin registrarse. Vacío = acceso invitado apagado (404).
GUEST_ACCESS_PIN=

# --- Detrás de Cloudflare (docs/reference/DEPLOY.md, "Etapa 3") ---
# Secreto que Cloudflare agrega en X-Oido-Edge. Vacío = se acepta todo, como
# en local.
EDGE_SHARED_SECRET=
# Clave secreta de Cloudflare Turnstile. Vacía = login y registro sin
# anti-robots. Para probar: 1x0000000000000000000000000000000AA (siempre pasa).
TURNSTILE_SECRET_KEY=
