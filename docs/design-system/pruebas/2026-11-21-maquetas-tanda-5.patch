@@ -0,0 +1,59 @@
+import type { SVGProps } from "react";
+
+/**
+ * Tres dibujos propios para el ícono del asistente (maqueta tanda 5). Son de
+ * trazo, 24×24, 1,75 de grosor y `currentColor`, como los de `components/icons`.
+ *
+ * - `o`: la «o» de «oído» de la marca: la letra gorda e inclinada, con su
+ *   hueco inclinado como el de `isotipo-o`.
+ * - `oreja`: una oreja de trazo simple.
+ * - `globo`: un globo de diálogo con una onda de voz adentro.
+ */
+export type VarianteAsistente = "o" | "oreja" | "globo";
+
+export default function AsistenteIcono({
+  variante,
+  size = 22,
+  ...rest
+}: { variante: VarianteAsistente; size?: number } & Omit<SVGProps<SVGSVGElement>, "ref">) {
+  return (
+    <svg
+      xmlns="http://www.w3.org/2000/svg"
+      viewBox="0 0 24 24"
+      width={size}
+      height={size}
+      fill="none"
+      stroke="currentColor"
+      strokeWidth={1.75}
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden
+      {...rest}
+    >
+      {variante === "o" && (
+        <>
+          {/* La «o», gorda y un poco caída hacia la derecha como la letra de la marca. */}
+          <ellipse cx="12" cy="14.2" rx="7.4" ry="6.2" transform="rotate(-9 12 14.2)" strokeWidth="2.4" />
+          {/* El acento de «oído», sobre la letra. */}
+          <path d="M14.6 4.6 17 2.8" strokeWidth="2.4" />
+        </>
+      )}
+      {variante === "oreja" && (
+        <>
+          {/* El borde de afuera, hasta el lóbulo. */}
+          <path d="M7 10.2C7 6.9 9.2 4.5 12.2 4.5c3 0 5.1 2.2 5.1 5.1 0 2.3-1.3 3.4-2.5 4.6-1 1-1.5 1.9-1.5 3.1a2.7 2.7 0 0 1-5.3.7" />
+          {/* El pliegue de adentro. */}
+          <path d="M10 10.4c0-1.3.9-2.2 2.1-2.2 1.2 0 2.1.9 2.1 2.1 0 1-.6 1.5-1.2 2" />
+        </>
+      )}
+      {variante === "globo" && (
+        <>
+          {/* El globo, con la colita abajo a la izquierda. */}
+          <path d="M6 4.5h12a2.5 2.5 0 0 1 2.5 2.5v7.5a2.5 2.5 0 0 1-2.5 2.5h-6.3L7.4 20.2V17H6a2.5 2.5 0 0 1-2.5-2.5V7A2.5 2.5 0 0 1 6 4.5Z" />
+          {/* La onda de voz. */}
+          <path d="M8 10.8v1.4M10.5 8.9v5.2M13 7.9v7.2M15.5 9.7v3.6" />
+        </>
+      )}
+    </svg>
+  );
+}
diff --git a/frontend/components/MasAdelante.tsx b/frontend/components/MasAdelante.tsx
new file mode 100644
index 0000000..0dda02b
--- /dev/null
+++ b/frontend/components/MasAdelante.tsx
@@ -0,0 +1,66 @@
+"use client";
+
+import { useState } from "react";
+import { fechaCorta } from "@/lib/semana";
+
+/** Una fila de «Más adelante»: un turno de una semana que todavía no se ve. */
+export interface FilaFutura {
+  id: string;
+  /** "YYYY-MM-DD" en Argentina. */
+  clave: string;
+  puesto: string;
+  estado: string;
+  /** Clase de color del estado (`text-success-text`…). */
+  tono: string;
+  pago: string;
+}
+
+const TOPE = 3;
+
+/**
+ * El último grupo de la lista (maqueta tanda 5, 2.ª vuelta): los turnos de
+ * semanas que vienen, en filas de una línea y sin acciones, para que al elegir
+ * una semana no desaparezca lo que viene después. Tocar una fila salta a su
+ * semana con ese día elegido. Muestra tres; el resto, con «Ver los N que
+ * siguen». La usan Mis turnos y el Panel del comercio.
+ */
+export default function MasAdelante({ filas, onElegir }: { filas: FilaFutura[]; onElegir: (clave: string) => void }) {
+  const [todas, setTodas] = useState(false);
+  if (filas.length === 0) return null;
+  const vistas = todas ? filas : filas.slice(0, TOPE);
+  const resto = filas.length - TOPE;
+  return (
+    <section data-testid="mas-adelante" className="mt-8 min-w-0">
+      <h2 className="titulo-seccion mb-3">
+        Más adelante
+        <span className="ml-1.5 text-sm font-semibold text-ink-soft">{filas.length}</span>
+      </h2>
+      <ul role="list" className="flex flex-col gap-2 md:max-w-xl">
+        {vistas.map((f) => (
+          <li key={f.id}>
+            <button
+              type="button"
+              onClick={() => onElegir(f.clave)}
+              className="turno-fila flex min-h-[48px] w-full items-center gap-2.5 px-3.5 py-2 text-left"
+              aria-label={`${fechaCorta(f.clave)}, ${f.puesto}, ${f.estado}, ${f.pago}. Ver esa semana`}
+            >
+              <span className="w-[88px] shrink-0 whitespace-nowrap text-sm font-bold text-ink">{fechaCorta(f.clave)}</span>
+              <span className="min-w-0 flex-1 truncate text-sm font-semibold text-ink">{f.puesto}</span>
+              <span className={`shrink-0 text-xs font-bold ${f.tono}`}>{f.estado}</span>
+              <span className="w-[58px] shrink-0 text-right text-sm font-bold tabular-nums text-ink">{f.pago}</span>
+            </button>
+          </li>
+        ))}
+      </ul>
+      {!todas && resto > 0 && (
+        <button
+          type="button"
+          onClick={() => setTodas(true)}
+          className="mt-1 flex min-h-[44px] items-center px-1 text-sm font-bold text-primary-text"
+        >
+          Ver {resto === 1 ? "el que sigue" : `los ${resto} que siguen`}
+        </button>
+      )}
+    </section>
+  );
+}
diff --git a/frontend/components/SemanaTira.tsx b/frontend/components/SemanaTira.tsx
new file mode 100644
index 0000000..5fe0896
--- /dev/null
+++ b/frontend/components/SemanaTira.tsx
@@ -0,0 +1,100 @@
+"use client";
+
+import { ChevronLeftIcon, ChevronRightIcon } from "@/components/icons";
+import type { DiaSemana } from "@/lib/semana";
+import { rotuloSemana } from "@/lib/semana";
+
+/**
+ * La semana del cielo, que se toca (maqueta tanda 5): siete días de lunes a
+ * domingo. Tocar uno lo elige (la tecla blanca) y la lista de abajo muestra
+ * sólo ese día; tocarlo de nuevo vuelve a la semana entera. «Hoy», sin
+ * elegir, lleva un aro fino. Un punto marca los días con turnos. Las flechas
+ * de vidrio cambian de semana. La usan Mis turnos y el Panel del comercio.
+ */
+export default function SemanaTira({
+  dias,
+  conTurno,
+  elegido,
+  onElegir,
+  onSemana,
+  esActual,
+  puntoAntes = false,
+  puntoDespues = false,
+  onVolver,
+}: {
+  dias: DiaSemana[];
+  conTurno: Set<string>;
+  elegido: string | null;
+  onElegir: (clave: string | null) => void;
+  onSemana: (paso: -1 | 1) => void;
+  esActual: boolean;
+  /** Hay turnos en semanas anteriores / siguientes: un puntito en la flecha. */
+  puntoAntes?: boolean;
+  puntoDespues?: boolean;
+  /** Estando en otra semana: «Volver a esta semana». */
+  onVolver?: () => void;
+}) {
+  return (
+    <div data-testid="semana-tira">
+      <div className="flex items-center justify-between gap-2">
+        <button
+          type="button"
+          onClick={() => onSemana(-1)}
+          className="flecha-vidrio relative"
+          aria-label={puntoAntes ? "Semana anterior, con turnos" : "Semana anterior"}
+        >
+          <ChevronLeftIcon size={16} />
+          {puntoAntes && <span aria-hidden data-punto="antes" className="flecha-punto" />}
+        </button>
+        <div className="flex min-w-0 flex-col items-center gap-1.5">
+          <p className="text-caption font-bold" aria-live="polite">
+            {esActual ? "Esta semana" : "Semana"} · {rotuloSemana(dias)}
+          </p>
+          {!esActual && onVolver && (
+            <button type="button" onClick={onVolver} className="chip-vidrio relative !px-3 !py-1 text-xs before:absolute before:-inset-x-2 before:-inset-y-2 before:content-['']">
+              Volver a esta semana
+            </button>
+          )}
+        </div>
+        <button
+          type="button"
+          onClick={() => onSemana(1)}
+          className="flecha-vidrio relative"
+          aria-label={puntoDespues ? "Semana siguiente, con turnos" : "Semana siguiente"}
+        >
+          <ChevronRightIcon size={16} />
+          {puntoDespues && <span aria-hidden data-punto="despues" className="flecha-punto" />}
+        </button>
+      </div>
+      <ol role="list" aria-label="Días de la semana" className="mt-2 grid grid-cols-7 text-center md:max-w-md">
+        {dias.map((d) => {
+          const hay = conTurno.has(d.clave);
+          const es = elegido === d.clave;
+          return (
+            <li key={d.clave} data-dia={d.clave} className="flex flex-col items-center">
+              <button
+                type="button"
+                aria-pressed={es}
+                onClick={() => onElegir(es ? null : d.clave)}
+                className="dia-boton flex min-h-[44px] w-full flex-col items-center gap-1 pb-1.5"
+              >
+                <span aria-hidden className={`text-xs ${d.esHoy ? "font-bold" : "font-semibold"}`}>
+                  {d.corto}
+                </span>
+                <span aria-hidden className={`dia-cielo ${es ? "dia-cielo-hoy" : d.esHoy ? "dia-cielo-aro" : ""}`}>
+                  {d.numero}
+                </span>
+                <span aria-hidden data-con-turno={hay ? "" : undefined} className={`dia-cielo-punto ${hay ? "" : "opacity-0"}`} />
+                <span className="sr-only">
+                  {d.largo} {d.numero}
+                  {d.esHoy && ", hoy"}
+                  {hay && ", con turno"}
+                </span>
+              </button>
+            </li>
+          );
+        })}
+      </ol>
+    </div>
+  );
+}
