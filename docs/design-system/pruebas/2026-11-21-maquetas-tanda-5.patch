diff --git a/frontend/components/worker/UrgentesRow.tsx b/frontend/components/worker/UrgentesRow.tsx
new file mode 100644
index 0000000..ac2fc47
--- /dev/null
+++ b/frontend/components/worker/UrgentesRow.tsx
@@ -0,0 +1,83 @@
+"use client";
+
+import Link from "next/link";
+import { SKILL_LABELS, Shift } from "@/lib/types";
+import { SKILL_ACCENT } from "@/lib/skill-style";
+import { formatPayCompact } from "@/lib/pay";
+import { formatDistance } from "@/lib/format";
+import { FlameIcon } from "@/components/icons";
+import { useAhora } from "@/lib/use-ahora";
+
+/** Ventana de «Urgentes»: lo que empieza en las próximas 6 horas. */
+const VENTANA_MS = 6 * 60 * 60 * 1000;
+
+/** «1 h 40», «2 h», «35 min». */
+export function faltaEn(ms: number): string {
+  const min = Math.max(1, Math.ceil(ms / 60_000));
+  if (min < 60) return `${min} min`;
+  const h = Math.floor(min / 60);
+  const m = min % 60;
+  return m === 0 ? `${h} h` : `${h} h ${m}`;
+}
+
+/**
+ * «Urgentes» (maqueta tanda 5): arriba de la hoja del Inicio, una fila
+ * horizontal de tarjetas compactas con los turnos que empiezan en las
+ * próximas ~6 horas y una cuenta regresiva (se actualiza por minuto, en el
+ * rojo de «Urgente» que ya existe). Sin ninguno, no se dibuja.
+ */
+export default function UrgentesRow({
+  shifts,
+  distanceOf,
+}: {
+  shifts: Shift[];
+  distanceOf: (s: Shift) => number | null;
+}) {
+  const ahora = useAhora(shifts.length > 0, 60_000);
+  const proximos = shifts
+    .map((s) => ({ s, falta: new Date(s.start_at).getTime() - ahora.getTime() }))
+    .filter((x) => x.falta > 0 && x.falta <= VENTANA_MS)
+    .sort((a, b) => a.falta - b.falta);
+  if (proximos.length === 0) return null;
+
+  return (
+    <section data-testid="feed-urgentes" aria-labelledby="urgentes-titulo" className="mb-6">
+      <h2 id="urgentes-titulo" className="flex items-center gap-1.5 text-h3 font-bold text-ink">
+        <FlameIcon size={18} className="text-danger-text" aria-hidden /> Urgentes
+      </h2>
+      <ul
+        role="list"
+        className="no-scrollbar -mx-4 mt-3 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-3 pt-1 md:-mx-6 md:px-6"
+      >
+        {proximos.map(({ s, falta }) => {
+          const { Icon } = SKILL_ACCENT[s.position];
+          const km = distanceOf(s);
+          return (
+            <li key={s.id} className="w-[232px] shrink-0 snap-start">
+              <Link href={`/turno/${s.id}`} className="tecla urgente-tarjeta flex h-full flex-col gap-2 p-3">
+                <span className="chip-urgencia self-start">
+                  <FlameIcon size={12} aria-hidden /> Empieza en {faltaEn(falta)}
+                </span>
+                <span className="text-[length:min(1.5rem,7vw)] font-extrabold leading-none tracking-tight tabular-nums text-ink">
+                  {formatPayCompact(s)}
+                </span>
+                <span className="flex min-w-0 items-center gap-2">
+                  <span className="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-cielo-tint text-cielo-text">
+                    <Icon size={15} />
+                  </span>
+                  <span className="min-w-0">
+                    <span className="block truncate text-fila font-bold leading-tight text-ink">{SKILL_LABELS[s.position]}</span>
+                    <span className="block truncate text-caption text-ink-soft">
+                      {s.company_name ?? "Comercio"}
+                      {km != null && ` · ${formatDistance(km)}`}
+                    </span>
+                  </span>
+                </span>
+              </Link>
+            </li>
+          );
+        })}
+      </ul>
+    </section>
+  );
+}
