diff --git a/frontend/app/globals.css b/frontend/app/globals.css
index 1d08861..3354c56 100644
--- a/frontend/app/globals.css
+++ b/frontend/app/globals.css
@@ -4728,3 +4728,158 @@ body:has([data-landing]) main {
   white-space: nowrap;
   box-shadow: 0 10px 22px rgba(28, 84, 120, 0.3);
 }
+
+/* ===== PRUEBA: la landing con la dirección suave (2026-11-21, sin decidir) =====
+   Se mantiene lo que es de marca (la brocha del inicio, el cierre y la carta,
+   la rueda de fotos, la comanda, el filete) y cambia lo que en la app ya
+   cambió: el cielo, las nubes, los botones, las tarjetas y los títulos. */
+[data-landing] {
+  /* El cielo de la app (más vivo) y los radios de la hoja. */
+  --l-cielo-1: #5ba8e0;
+  --l-cielo-2: #84c0ec;
+  --l-cielo-3: #bfe1f6;
+  --l-cielo-4: #e3f1fa;
+  --l-tinte: #e6f1f8;
+  --l-radio: 24px;
+  --l-panel: 28px;
+  --l-sombra: 0 14px 30px rgba(15, 58, 91, 0.14), 0 0 0 1px rgba(15, 58, 91, 0.05);
+  --l-sombra-chica: 0 1px 2px rgba(15, 58, 91, 0.06), 0 6px 16px rgba(15, 58, 91, 0.08);
+  --l-hondo-degrade: linear-gradient(180deg, #2a73a3, #1c5478);
+}
+@media (max-width: 640px) {
+  [data-landing] {
+    --l-panel: 24px;
+  }
+}
+/* Los títulos de sección, en la letra de la app: grande, pesada y apretada. */
+[data-landing] .landing-h2 {
+  font-family: var(--font-inter), system-ui, sans-serif;
+  font-weight: 800;
+  font-synthesis-weight: auto;
+  font-size: clamp(2rem, 4.4vw, 3.4rem);
+  line-height: 1.05;
+  letter-spacing: -0.03em;
+}
+/* Botones: redondeados y con sombra difusa, como los de la app. */
+[data-landing] .landing-btn {
+  border-radius: 18px;
+  font-weight: 700;
+  box-shadow: var(--l-sombra-chica);
+}
+[data-landing] .landing-btn:active,
+[data-landing] .landing-btn.landing-apretado {
+  transform: scale(0.98);
+  box-shadow: 0 1px 2px rgba(15, 58, 91, 0.08);
+}
+/* El principal: el ámbar de la app, en degradé con sombra de su color. */
+[data-landing] .landing-btn-primario,
+[data-landing] .landing-noche .landing-btn-primario {
+  background: linear-gradient(180deg, #f6a92a, #e58e0f);
+  color: #111111;
+  box-shadow:
+    0 10px 24px rgba(217, 119, 6, 0.28),
+    inset 0 1px 0 rgba(255, 255, 255, 0.45),
+    inset 0 -2px 0 rgba(0, 0, 0, 0.08);
+}
+[data-landing] .landing-btn-primario .landing-btn-flecha,
+[data-landing] .landing-noche .landing-btn-primario .landing-btn-flecha {
+  background: rgba(255, 255, 255, 0.55);
+  color: #111111;
+}
+/* El secundario: una tecla blanca con el texto en azul hondo. */
+[data-landing] .landing-btn-borde {
+  background: #ffffff;
+  color: #1c5478;
+  box-shadow: var(--l-sombra-chica);
+}
+[data-landing] .landing-btn-borde .landing-btn-flecha {
+  background: #e6f1f8;
+  color: #1c5478;
+}
+/* «Pedir»: azul hondo, como lo elegido en la app. */
+[data-landing] .landing-btn-tinta {
+  background: var(--l-hondo-degrade);
+  color: #ffffff;
+  box-shadow: 0 8px 18px rgba(28, 84, 120, 0.3);
+}
+[data-landing] .landing-btn-tinta .landing-btn-flecha {
+  background: rgba(255, 255, 255, 0.22);
+  color: #ffffff;
+}
+/* El inicio: la luz de arriba a la derecha y las nubes con volumen de la app
+   en lugar de los cirros. El banco de nubes de abajo se queda. */
+[data-landing] .landing-hero {
+  background:
+    radial-gradient(120% 60% at 88% 0%, rgba(255, 255, 255, 0.22), transparent 60%),
+    linear-gradient(180deg, var(--l-cielo-1) 0%, var(--l-cielo-2) 40%, var(--l-cielo-3) 72%, var(--l-cielo-4) 100%);
+}
+[data-landing] .landing-cirro {
+  display: none;
+}
+[data-landing] .landing-hero::before,
+[data-landing] .landing-hero::after {
+  content: "";
+  position: absolute;
+  z-index: 0;
+  pointer-events: none;
+  background: center / contain no-repeat;
+}
+[data-landing] .landing-hero::before {
+  right: -70px;
+  top: calc(var(--lht) + 4px);
+  width: min(300px, 62vw);
+  aspect-ratio: 2 / 1;
+  background-image: url("/cielo/nube-a.webp");
+}
+[data-landing] .landing-hero::after {
+  left: -40px;
+  top: calc(var(--lht) + 150px);
+  width: min(150px, 34vw);
+  aspect-ratio: 2 / 1;
+  opacity: 0.85;
+  background-image: url("/cielo/nube-b.webp");
+}
+/* El campo del pedido: sin contorno duro, una tecla blanca. */
+[data-landing] .landing-campo {
+  border-radius: 20px;
+  box-shadow: var(--l-sombra);
+}
+[data-landing] .landing-campo:focus-within {
+  box-shadow:
+    0 0 0 2.5px #2a73a3,
+    var(--l-sombra);
+}
+/* Las piezas con sombra dura pasan a sombra difusa y esquinas redondas. */
+[data-landing] .landing-impresora {
+  border-radius: 16px 16px 6px 6px;
+  box-shadow:
+    0 14px 26px rgba(15, 58, 91, 0.28),
+    inset 0 1px 0 rgb(255 255 255 / 0.12);
+}
+[data-landing] .landing-mapa {
+  border-radius: var(--l-radio);
+  box-shadow: var(--l-sombra);
+}
+[data-landing] .landing-carta {
+  border-radius: var(--l-radio);
+  box-shadow: var(--l-sombra);
+}
+[data-landing] .landing-carta-dentro {
+  border-radius: 16px;
+  border-width: 1px;
+  outline: 0;
+}
+[data-landing] .landing-pizarra {
+  border-radius: 20px;
+  box-shadow: 0 16px 34px rgba(15, 58, 91, 0.3);
+}
+[data-landing] .landing-noche .landing-tarjeta {
+  border-radius: var(--l-radio);
+  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
+}
+/* Quien trabaja: el cielo hondo de la app, no el casi negro. */
+[data-landing] .landing-noche {
+  background:
+    radial-gradient(120% 80% at 88% 0%, rgba(120, 180, 225, 0.2), transparent 60%),
+    linear-gradient(180deg, #0f3a5b, #174a6c 55%, #1f5e88);
+}
